FROM --platform=$BUILDPLATFORM golang:1.26.5-alpine AS builder

ARG TARGETOS=linux
ARG TARGETARCH

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build \
    -ldflags="-w -s" \
    -o /out/cloudworker ./cmd/cloudworker

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -u 10001 cloudworker

WORKDIR /app

COPY --from=builder /out/cloudworker /usr/local/bin/cloudworker

USER cloudworker
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/cloudworker"]
